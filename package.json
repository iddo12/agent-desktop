{
  "name": "agent-desktop",
  "version": "1.59.0",
  "description": "Standalone desktop app for managing and chatting with local Claude Code agents",
  "main": "src/main.js",
  "author": "LensVid",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis zip --publish never",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-pty@1.1.0": true
  },
  "build": {
    "appId": "com.lensvid.agentdesktop",
    "productName": "Agent Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json",
      "!**/*.log",
      "!sessions/**",
      "!tools/**",
      "!CLAUDE.md",
      "!.claude/**",
      "!Launch.vbs",
      "!Start-TestDesktop.bat"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
